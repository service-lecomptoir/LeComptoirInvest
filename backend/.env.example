ENV=production
DEBUG=false
DATABASE_URL=postgresql+asyncpg://invest_user:CHANGE_ME@localhost:5432/lecomptoirinvest
# REQUIRED, no default: it signs the tokens and, while DATA_ENCRYPTION_KEYS is empty,
# derives the key that encrypts the investors' IBANs. Generate one per deployment and
# never reuse another product's.
SECRET_KEY=
# The keys of the IBANs, comma separated Fernet keys: the first encrypts, all decrypt.
# Empty = the key derived from SECRET_KEY (as before). Set and rotated in production with
# docs/rotation_cle_donnees.ps1, never by hand. A new key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEYS=
# The fund's own accounts, one per currency it holds, comma separated.
FUND_IBANS=
# Where the screens are served: the password links of the e-mails point there.
PUBLIC_APP_URL=https://invest.lecomptoir.services
ALICE_URL=
ALICE_INTERNAL_KEY=
# Days a line of the audit journal is kept (purged daily). 0 keeps everything.
AUDIT_RETENTION_DAYS=90
